# Resend API key — get yours free at resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The email address that contact form submissions get sent to
CONTACT_EMAIL=your@email.com

# Optional: GitHub token for the live contribution calendar.
# Without it the site falls back to a public mirror of the same data.
# A classic token with no scopes is enough for public contributions.
GITHUB_TOKEN=
